-- Agenda State 这个盒子：工作流效果每一次对 GitHub 的外部写入的持久记录。
-- 只写每个端口在数据上的前后条件；持久化、执行、确认与崩溃恢复的先后由 design/behavior 持有。
-- 精度停在“一次写入至多记为执行中一次、只结算一次”：写入的内容与目标，
-- 以及议程、工单、裁决与占用议程的协调者，都不在这个盒子里展开。
module dispatch_agendaStore
exports
  types
    EffectId; struct Outcome
  operations
    beginWrite : EffectId ==> ();
    settleWrite : EffectId * Outcome ==> ()
definitions
types
  EffectId = token;
  -- 一次写入的结局：新的 GitHub 读取显示了它、失败，或结局未知。
  Outcome = <Confirmed> | <Failed> | <Uncertain>;

-- 哪些写入已记为执行中、尚无结局，以及每次已结算写入的结局。
state Effects of
  executing : set of EffectId
  outcomes  : map EffectId to Outcome
inv mk_Effects(x, o) ==
  x inter dom o = {}
init s == s = mk_Effects({}, {|->})
end

operations
  -- REQ-91
  -- 写入在执行之前先持久记为执行中；已在执行中或已结算的写入不会再次被记为执行中。
  beginWrite(e : EffectId)
  ext rd outcomes
      wr executing
  pre e not in set executing and e not in set dom outcomes
  post executing = executing~ union {e};

  -- REQ-91
  -- 执行中的写入恰好结算一次，记下它的结局。
  settleWrite(e : EffectId, o : Outcome)
  ext wr executing, outcomes
  pre e in set executing
  post executing = executing~ \ {e} and outcomes = outcomes~ munion {e |-> o};

end dispatch_agendaStore
