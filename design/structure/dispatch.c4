specification {
  element actor
  element system
  element container
  element store {
    style {
      shape storage
    }
  }
  element component

  tag external
  tag contract
  tag untrusted

  deploymentNode host
}

model {
  operator = actor 'Operator' {
    description 'Person who prepares issue trees on GitHub, clicks launch links, and directs delivery in the coordinator session'
  }

  dispatch = system 'omp-dispatch' {
    description 'Delivers a dependent GitHub issue tree through durable tickets into merged and closed results'

    launcher = container 'Launcher' {
      technology 'Local HTTP service'
      description 'Accepts launch-link clicks and issue-event deliveries, starts coordinators through a frontend, and checks Meerkat configuration'
    }

    coordinator = container 'Coordinator' {
      technology 'omp process with the dispatch extension'
      description 'Convenes the agenda of one issue and moves every ticket and the parent closure along its frozen workflow'

      main = component 'Main' {
        description 'Coordinator main session that convenes the agenda, decides when each ticket launches, and rules on escalations'
      }
      controller = component 'Relay Controller' {
        description 'Advances tickets and the parent closure along the frozen workflow and wakes Main for open decisions'
      }
      seatHost = component 'Seat Host' {
        description 'Runs one-shot work and judge seat sessions in their own checkouts and accepts their handoffs'
      }
      sourceReader = component 'Source Reader' {
        description 'Reads issue, PR, check, and Project facts from GitHub for workflow conditions and confirmations'
      }
      effects = component 'Effect Executor' {
        description 'Performs external GitHub and Meerkat writes, persisting each intent and confirming each outcome'
      }
    }

    agendaStore = store 'Agenda State' {
      technology 'Local state files'
      description 'Authoritative record of agendas, ticket states, rulings, the attached coordinator, and effect intents'
    }

    repoCache = store 'Repository Cache' {
      technology 'Local git repositories'
      description 'Local clone of each repository and the seat checkouts derived from it'
    }

    sessionStore = store 'Session Files' {
      technology 'omp session files'
      description 'Seat session transcripts that later seats of the same role fork from'
    }
  }

  github = system 'GitHub' {
    #external
    description 'Code platform hosting issues, PRs, checks, and Projects, and delivering issue events through a GitHub App'
  }

  tern = system 'Tern' {
    #external
    description 'Terminal frontend that opens tabs and runs coordinator processes in them'
  }

  modelProvider = system 'Model Provider' {
    #external
    description 'Large language model service answering the main and seat sessions'
  }

  meerkat = system 'Meerkat' {
    #external
    description 'External collaboration system whose configuration repository, intent guardians, and council settle owner questions'
  }

  // context
  operator -> dispatch 'clicks launch links and directs delivery'
  github -> dispatch 'delivers issue events'
  meerkat -> dispatch 'checks candidate configuration'
  dispatch -> tern 'opens or focuses a coordinator tab'
  tern -> dispatch 'runs the coordinator process'
  dispatch -> github 'reads and writes issues, PRs, and Projects, and syncs code'
  dispatch -> modelProvider 'requests model replies'
  dispatch -> meerkat 'reads configuration and submits questions'

  // dispatch containers
  operator -> dispatch.launcher 'clicks a launch link'
  operator -> dispatch.coordinator 'reviews status and directs Main'
  github -> dispatch.launcher 'delivers issue events'
  meerkat -> dispatch.launcher 'checks candidate configuration'
  dispatch.launcher -> tern 'opens or focuses a coordinator tab'
  tern -> dispatch.coordinator 'runs the coordinator process'
  dispatch.coordinator -> github 'reads and writes issues, PRs, and Projects, and syncs code'
  dispatch.coordinator -> modelProvider 'requests model replies'
  dispatch.coordinator -> meerkat 'reads configuration and submits questions'
  dispatch.coordinator -> dispatch.agendaStore 'persists agendas and effect intents'
  dispatch.coordinator -> dispatch.repoCache 'updates clones and checks out seat workspaces'
  dispatch.coordinator -> dispatch.sessionStore 'creates and forks seat sessions'

  // coordinator components
  operator -> dispatch.coordinator.main 'reviews status and gives directions'
  tern -> dispatch.coordinator.main 'runs the main session'
  dispatch.coordinator.main -> modelProvider 'requests main-session replies'
  dispatch.coordinator.main -> dispatch.coordinator.controller 'convenes, launches, resolves, and finishes'
  dispatch.coordinator.controller -> dispatch.coordinator.main 'wakes it for open decisions'
  dispatch.coordinator.controller -> dispatch.coordinator.seatHost 'seats work and judge roles'
  dispatch.coordinator.seatHost -> dispatch.coordinator.controller 'hands back submissions, verdicts, and escalations'
  dispatch.coordinator.controller -> dispatch.coordinator.sourceReader 'reads source facts'
  dispatch.coordinator.controller -> dispatch.coordinator.effects 'requests external writes'
  dispatch.coordinator.controller -> dispatch.agendaStore 'persists agendas and state transitions'
  dispatch.coordinator.controller -> meerkat 'reads Meerkat configuration'
  dispatch.coordinator.effects -> dispatch.agendaStore 'records effect intents and outcomes'
  dispatch.coordinator.effects -> dispatch.coordinator.sourceReader 'confirms writes with fresh reads'
  dispatch.coordinator.effects -> github 'writes issues, PRs, and Projects'
  dispatch.coordinator.effects -> meerkat 'sends question requests'
  dispatch.coordinator.sourceReader -> github 'reads issues, PRs, checks, and Projects'
  dispatch.coordinator.seatHost -> dispatch.repoCache 'updates clones and checks out seat workspaces'
  dispatch.coordinator.seatHost -> dispatch.sessionStore 'creates and forks seat sessions'
  dispatch.coordinator.seatHost -> modelProvider 'requests seat replies'
  dispatch.coordinator.seatHost -> github 'fetches code and pushes branches'
}

deployment {
  host workstation 'Operator workstation' {
    description 'Operator machine running the launcher, coordinators, the terminal frontend, and all local state'
    instanceOf dispatch.launcher
    instanceOf dispatch.coordinator
    instanceOf dispatch.agendaStore
    instanceOf dispatch.repoCache
    instanceOf dispatch.sessionStore
    instanceOf tern
  }
  host internet 'Internet services' {
    #untrusted
    description 'External services reached over the public internet, a separate trust boundary whose deliveries are accepted only with a valid App signature'
    instanceOf github
    instanceOf modelProvider
  }
}

views {
  view index {
    title 'omp-dispatch system context'
    description 'Whom omp-dispatch serves and which external systems it interacts with'
    include *
  }

  view dispatchView of dispatch {
    title 'omp-dispatch container diagram'
    description 'Which runtime units and data stores make up omp-dispatch and how they call each other and the outside'
    include *
  }

  view coordinatorView of dispatch.coordinator {
    title 'Coordinator component diagram'
    description 'Which functional blocks make up the Coordinator and how they call each other and the outside'
    include *
  }

  deployment view deployed {
    title 'omp-dispatch deployment diagram'
    description 'Where the omp-dispatch containers and data stores run and where the trust boundary lies'
    include workstation.**
    include internet.**
    exclude * -> * where source.kind is component or target.kind is component
  }
}
