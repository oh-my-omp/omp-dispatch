specification {
  element actor
  element system
  element container
  element store {
    style {
      shape storage
    }
  }
  element component

  tag external
  tag contract
  tag untrusted

  deploymentNode host
}

model {
  operator = actor 'Operator' {
    description 'Person who writes issue trees on GitHub, launches their delivery, and directs it'
  }

  dispatch = system 'omp-dispatch' {
    description 'Delivers a GitHub issue tree with dependencies into merged pull requests and closed issues'

    launcher = container 'Launcher' {
      technology 'Local HTTP service'
      description 'Local HTTP entry for callers outside any coordinator: starts coordinators on launch-link clicks and issue-event deliveries, and validates Meerkat configuration edits'
    }

    coordinator = container 'Coordinator' {
      technology 'omp process with the dispatch extension'
      description 'Runs the delivery of one issue tree, moving every ticket through its workflow with agent sessions'

      main = component 'Main' {
        description 'Coordinator main session that convenes the agenda, decides when each ticket launches, and rules on escalations'
      }
      controller = component 'Workflow Controller' {
        description 'Advances tickets and the parent closure through the workflow and wakes Main for open decisions'
      }
      seatHost = component 'Seat Host' {
        description 'Runs one-shot work and judge seat sessions in their own checkouts and accepts their handoffs'
      }
      sourceReader = component 'Source Reader' {
        description 'Reads issue, PR, check, and Project facts from GitHub and Meerkat configuration for workflow conditions'
      }
      effects = component 'Effect Executor' {
        description 'Performs external GitHub and Meerkat writes and records each outcome'
      }
    }

    agendaStore = store 'Agenda State' {
      #contract
      technology 'Local state files'
      description 'Authoritative record of delivery progress and of every external write'
    }

    repoCache = store 'Repository Cache' {
      technology 'Local git repositories'
      description 'Local clone of each repository and the per-session checkouts derived from it'
    }

    sessionStore = store 'Session Files' {
      technology 'omp session files'
      description 'Agent session transcripts that later sessions for the same ticket continue from'
    }
  }

  github = system 'GitHub' {
    #external
    description 'Code platform hosting issues, pull requests, checks, and Projects, and delivering issue events'
  }

  tern = system 'Tern' {
    #external
    description 'Terminal frontend that runs omp-dispatch delivery processes in its tabs'
  }

  modelProvider = system 'Model Provider' {
    #external
    description 'Large language model service answering the agent sessions omp-dispatch runs'
  }

  meerkat = system 'Meerkat' {
    #external
    description 'External collaboration system that supplies configuration and settles owner questions'
  }

  // context
  operator -> github 'writes issue trees'
  operator -> tern 'watches delivery tabs'
  operator -> dispatch 'launches and directs deliveries'
  github -> dispatch 'delivers issue events'
  meerkat -> dispatch 'asks to validate configuration edits'
  dispatch -> tern 'opens a delivery tab'
  tern -> dispatch 'runs delivery processes'
  dispatch -> github 'reads and writes issues and code'
  dispatch -> modelProvider 'requests replies'
  dispatch -> meerkat 'reads configuration and asks questions'

  // dispatch containers
  operator -> dispatch.launcher 'clicks a launch link'
  operator -> dispatch.coordinator 'reviews status and directs delivery'
  github -> dispatch.launcher 'delivers issue events'
  meerkat -> dispatch.launcher 'asks to validate configuration edits'
  dispatch.launcher -> tern 'opens or focuses a coordinator tab'
  tern -> dispatch.coordinator 'runs the coordinator process'
  dispatch.coordinator -> github 'reads and writes issues and code'
  dispatch.coordinator -> modelProvider 'requests replies'
  dispatch.coordinator -> meerkat 'reads configuration and asks questions'
  dispatch.coordinator -> dispatch.agendaStore 'persists delivery progress and external writes'
  dispatch.coordinator -> dispatch.repoCache 'updates clones and checks out workspaces'
  dispatch.coordinator -> dispatch.sessionStore 'creates and continues sessions'

  // coordinator components
  operator -> dispatch.coordinator.main 'reviews status and gives directions'
  tern -> dispatch.coordinator.main 'runs the main session'
  dispatch.coordinator.main -> modelProvider 'requests main-session replies'
  dispatch.coordinator.main -> dispatch.coordinator.controller 'directs the agenda and ticket launches'
  dispatch.coordinator.controller -> dispatch.coordinator.main 'wakes Main for open decisions'
  dispatch.coordinator.controller -> dispatch.coordinator.seatHost 'seats work and judge roles'
  dispatch.coordinator.seatHost -> dispatch.coordinator.controller 'submits work, verdicts, and escalations'
  dispatch.coordinator.controller -> dispatch.coordinator.sourceReader 'reads source facts'
  dispatch.coordinator.controller -> dispatch.coordinator.effects 'requests external writes'
  dispatch.coordinator.controller -> dispatch.agendaStore 'persists delivery progress'
  dispatch.coordinator.effects -> dispatch.agendaStore 'records external writes and outcomes'
  dispatch.coordinator.effects -> github 'writes issues, PRs, and Projects'
  dispatch.coordinator.effects -> meerkat 'sends question requests'
  dispatch.coordinator.sourceReader -> github 'reads issues, PRs, checks, and Projects'
  dispatch.coordinator.sourceReader -> meerkat 'reads configuration'
  dispatch.coordinator.seatHost -> dispatch.repoCache 'updates clones and checks out seat workspaces'
  dispatch.coordinator.seatHost -> dispatch.sessionStore 'creates and continues seat sessions'
  dispatch.coordinator.seatHost -> modelProvider 'requests seat replies'
  dispatch.coordinator.seatHost -> github 'fetches and pushes code'
}

deployment {
  host workstation 'Operator workstation' {
    description 'Operator machine running the launcher, coordinators, the terminal frontend, Meerkat, and all local state'
    instanceOf dispatch.launcher
    instanceOf dispatch.coordinator
    instanceOf dispatch.agendaStore
    instanceOf dispatch.repoCache
    instanceOf dispatch.sessionStore
    instanceOf tern
    instanceOf meerkat
  }
  host internet 'Internet services' {
    #untrusted
    description 'External services reached over the public internet, outside the operator machine trust boundary'
    instanceOf github
    instanceOf modelProvider
  }
}

views {
  view index {
    title 'omp-dispatch system context'
    description 'Whom omp-dispatch serves and which external systems it interacts with'
    include *
  }

  view dispatchView of dispatch {
    title 'omp-dispatch container diagram'
    description 'Which runtime units and data stores make up omp-dispatch and how they call each other and the outside'
    include *
  }

  view coordinatorView of dispatch.coordinator {
    title 'Coordinator component diagram'
    description 'Which functional blocks make up the Coordinator and how they call each other and the outside'
    include *
  }

  deployment view deployed {
    title 'omp-dispatch deployment diagram'
    description 'Where the omp-dispatch containers and data stores run and where the trust boundary lies'
    include workstation.**
    include internet.**
    exclude * -> * where source.kind is component or target.kind is component
  }
}
